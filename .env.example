DATABASE_URL=postgres://workouthub:workouthub@127.0.0.1:5432/workouthub
# Set true only if your Postgres provider requires SSL.
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Set to true only when you intentionally want startup to rotate the admin password.
ADMIN_PASSWORD_ROTATE=false
